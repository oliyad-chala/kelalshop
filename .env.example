# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Production site URL (required for OAuth redirects and metadata)
NEXT_PUBLIC_SITE_URL=https://kelalshop.com

# AI support chat (optional in development)
GROQ_API_KEY=your_groq_api_key
GEMINI_API_KEY=your_gemini_api_key

# Chapa payment verification (https://chapa.co)
CHAPA_SECRET_KEY=sk_live_your_chapa_secret_key

# Resend Email (https://resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxx
# Use onboarding@resend.dev for testing, or your verified domain address in production
EMAIL_FROM=KelalShop <noreply@kelalshop.com>

# Telegram Integration
TELEGRAM_BOT_TOKEN=your_admin_bot_token
TELEGRAM_CUSTOMER_BOT_TOKEN=your_customer_bot_token
# Target Telegram Channel for auto-posting approved products (e.g. @kelalshop_channel or -100xxxxxxxxxx)
TELEGRAM_CHANNEL_ID=@your_channel_username
